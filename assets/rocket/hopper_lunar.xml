<mujoco model="vtvl_hopper_lunar">
    <compiler angle="degree" coordinate="local"/>

    <option gravity="0 0 -1.62"
            timestep="0.002"
            integrator="implicitfast"
            iterations="80"/>

    <asset>
        <material name="body_mat" rgba="0.7 0.7 0.7 1"/>
        <material name="leg_mat" rgba="0.2 0.2 0.2 1"/>
        <material name="foot_mat" rgba="0.9 0.9 0.2 1"/>
        <material name="engine_mat" rgba="0.8 0.2 0.2 1"/>
    </asset>

    <worldbody>
        <body name="hopper" pos="0 0 0.355">
            <freejoint/>

            <inertial pos="0 0 0"
                      mass="1.63"
                      diaginertia="0.025 0.025 0.008"/>

            <site name="COM"
                  pos="0 0 0"
                  size="0.02"
                  rgba="1 0 0 1"/>

            <geom name="main_body"
                  type="cylinder"
                  fromto="0 0 -0.150 0 0 0.445"
                  size="0.06"
                  material="body_mat"
                  contype="1"
                  conaffinity="1"/>

            <geom name="leg1"
                  type="capsule"
                  fromto="0 0 -0.005 0.4 0 -0.355"
                  size="0.012"
                  material="leg_mat"
                  contype="0"
                  conaffinity="0"/>
            <geom name="foot1_geom"
                  type="sphere"
                  pos="0.4 0 -0.355"
                  size="0.025"
                  material="foot_mat"
                  contype="1"
                  conaffinity="1"/>
            <site name="foot1"
                  pos="0.4 0 -0.355"
                  size="0.015"
                  rgba="1 0 0 1"/>

            <geom name="leg2"
                  type="capsule"
                  fromto="0 0 -0.005 -0.4 0 -0.355"
                  size="0.012"
                  material="leg_mat"
                  contype="0"
                  conaffinity="0"/>
            <geom name="foot2_geom"
                  type="sphere"
                  pos="-0.4 0 -0.355"
                  size="0.025"
                  material="foot_mat"
                  contype="1"
                  conaffinity="1"/>
            <site name="foot2"
                  pos="-0.4 0 -0.355"
                  size="0.015"
                  rgba="0 1 0 1"/>

            <geom name="leg3"
                  type="capsule"
                  fromto="0 0 -0.005 0 0.4 -0.355"
                  size="0.012"
                  material="leg_mat"
                  contype="0"
                  conaffinity="0"/>
            <geom name="foot3_geom"
                  type="sphere"
                  pos="0 0.4 -0.355"
                  size="0.025"
                  material="foot_mat"
                  contype="1"
                  conaffinity="1"/>
            <site name="foot3"
                  pos="0 0.4 -0.355"
                  size="0.015"
                  rgba="0 0 1 1"/>

            <geom name="leg4"
                  type="capsule"
                  fromto="0 0 -0.005 0 -0.4 -0.355"
                  size="0.012"
                  material="leg_mat"
                  contype="0"
                  conaffinity="0"/>
            <geom name="foot4_geom"
                  type="sphere"
                  pos="0 -0.4 -0.355"
                  size="0.025"
                  material="foot_mat"
                  contype="1"
                  conaffinity="1"/>
            <site name="foot4"
                  pos="0 -0.4 -0.355"
                  size="0.015"
                  rgba="1 1 0 1"/>

            <!-- Fixed main engine: replaces the old tvc_yaw/tvc_pitch gimbal
                 bodies+joints. No joints, no actuators; thrust is always
                 straight down the hopper's own -Z axis, so it passes through
                 the body's Z-axis and contributes zero torque about the CoM.
                 All attitude control now comes from the RCS ring below;
                 forces/torques for both are computed in Python
                 (LunarLanderEnv._pre_physics_step) from this site's and the
                 rcs_* sites' fixed local positions, not from MJCF actuators. -->
            <geom name="engine"
                  type="cylinder"
                  pos="0 0 -0.175"
                  size="0.04 0.02"
                  material="engine_mat"
                  contype="0"
                  conaffinity="0"/>
            <site name="thrust_site"
                  pos="0 0 -0.250"
                  size="0.02"
                  rgba="1 0.5 0 1"/>

            <!-- RCS thruster ring: 8 fixed-direction jets near the top of
                 main_body, 45deg apart, firing tangentially. Direction
                 alternates CCW/CW (even index = CCW, odd index = CW) so the
                 ring has bidirectional torque authority about all three body
                 axes; see rcs_thruster_layout in LunarLanderEnvCfg for the
                 authoritative direction vectors consumed by the env; these
                 sites are reference/visual markers only, not MJCF actuators. -->
            <site name="rcs_0" pos="0.070 0.000 0.40" size="0.012" rgba="0.2 0.6 1 1"/>   <!-- CCW -->
            <site name="rcs_1" pos="0.0495 0.0495 0.40" size="0.012" rgba="1 0.6 0.2 1"/> <!-- CW -->
            <site name="rcs_2" pos="0.000 0.070 0.40" size="0.012" rgba="0.2 0.6 1 1"/>   <!-- CCW -->
            <site name="rcs_3" pos="-0.0495 0.0495 0.40" size="0.012" rgba="1 0.6 0.2 1"/><!-- CW -->
            <site name="rcs_4" pos="-0.070 0.000 0.40" size="0.012" rgba="0.2 0.6 1 1"/>  <!-- CCW -->
            <site name="rcs_5" pos="-0.0495 -0.0495 0.40" size="0.012" rgba="1 0.6 0.2 1"/><!-- CW -->
            <site name="rcs_6" pos="0.000 -0.070 0.40" size="0.012" rgba="0.2 0.6 1 1"/>  <!-- CCW -->
            <site name="rcs_7" pos="0.0495 -0.0495 0.40" size="0.012" rgba="1 0.6 0.2 1"/><!-- CW -->
        </body>
    </worldbody>
</mujoco>
