def PhysicsScene "PhysicsScene" (
    apiSchemas = ["NewtonSceneAPI", "MjcSceneAPI"]
)
{
    uniform bool mjc:flag:multiccd = 0
    uniform token mjc:option:integrator = "implicitfast"
    uniform int mjc:option:iterations = 80
    uniform int newton:maxSolverIterations = 80
    uniform int newton:timeStepsPerSecond = 500
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 1.62
}

