                        apiSchemas = ["MjcSiteAPI"]
                    )
                    {
                        float3[] extent = [(-0.02, -0.02, -0.02), (0.02, 0.02, 0.02)]
                        color3f[] primvars:displayColor = [(1, 0.5, 0)] (
                            interpolation = "constant"
                        )
                        int[] primvars:displayColor:indices = None
                        float[] primvars:displayOpacity = [1] (
                            interpolation = "constant"
                        )
                        int[] primvars:displayOpacity:indices = None
                        uniform token purpose = "guide"
                        double radius = 0.02
                        quatf xformOp:orient = (1, 0, 0, 0)
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, -0.1)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                    }

                    def PhysicsRevoluteJoint "tvc_pitch_joint" (
                        apiSchemas = ["MjcJointAPI", "PhysxJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular", "IsaacJointAPI"]
                    )
                    {
                        float drive:angular:physics:maxForce = 2.5
                        uniform double mjc:armature = 0.002
                        uniform double mjc:damping = 0.1
                        uniform double mjc:frictionloss = 0.005
                        uniform token physics:axis = "Y"
                        rel physics:body0 = </vtvl_hopper_lunar/Geometry/hopper/tvc_yaw>
                        rel physics:body1 = </vtvl_hopper_lunar/Geometry/hopper/tvc_yaw/tvc_pitch>
                        point3f physics:localPos0 = (0, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                        float physics:lowerLimit = -25
                        float physics:upperLimit = 25
                        float physxJoint:armature = 0.002
                        float physxJoint:jointFriction = 0.005
                    }
                }

                def PhysicsRevoluteJoint "tvc_yaw_joint" (
                    apiSchemas = ["MjcJointAPI", "PhysxJointAPI", "PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular", "IsaacJointAPI"]
                )
                {
                    float drive:angular:physics:maxForce = 2.5
                    uniform double mjc:armature = 0.002
                    uniform double mjc:damping = 0.1
                    uniform double mjc:frictionloss = 0.005
                    uniform token physics:axis = "X"
                    rel physics:body0 = </vtvl_hopper_lunar/Geometry/hopper>
                    rel physics:body1 = </vtvl_hopper_lunar/Geometry/hopper/tvc_yaw>
                    point3f physics:localPos0 = (0, 0, -0.15)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                    float physics:lowerLimit = -25
                    float physics:upperLimit = 25
                    float physxJoint:armature = 0.002
                    float physxJoint:jointFriction = 0.005
                }
            }
        }
    }

